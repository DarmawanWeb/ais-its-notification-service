# ais-its-notification-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=notification
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3008
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "notify" ---------------------
DATABASE_URL=postgres://notify_svc:notify_svc@localhost:5432/aisits
DATABASE_SCHEMA=notify
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed.
NATS_URL=nats://localhost:4222
# Prefix of every durable consumer name (test suites sharing one server).
# NATS_DURABLE_PREFIX=

# --- Valkey (base variable; this service does not import RedisModule) ----------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP and realtime ----------------------------------------------------------------
# Also the allowed origins of the socket.io gateway at /ws.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
# Links in e-mails, Telegram messages and webhooks (/alerts?alert=<id>).
PUBLIC_BASE_URL=http://localhost:8000
# Proxies whose X-Forwarded-* headers are trusted (comma separated addresses / CIDRs).
# TRUSTED_PROXIES=

# --- E-mail (NOTIFY consumer notification-email, alert e-mails) ------------------------
# Mailpit in development (UI http://localhost:8025); smtps://user:pass@host:465 in production.
SMTP_URL=smtp://localhost:1025
SMTP_FROM="AIS Maritime Intelligence <no-reply@ais-its.local>"
# Connection, greeting and socket timeout of one SMTP attempt (an attempt is
# claimed for 4 × this, so a second copy of the request does not send it too).
SMTP_TIMEOUT_MS=30000

# --- Telegram Bot API (channel disabled while the token is unset) -----------------------
# TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000

# --- Webhooks (channel disabled while the secret is unset) ------------------------------
# HMAC-SHA256 key of X-AIS-ITS-Signature, 16+ characters: a random secret, never committed.
# WEBHOOK_SIGNING_SECRET=
# Total deadline of one webhook attempt (DNS, connect, TLS, request, response head).
WEBHOOK_TIMEOUT_MS=10000
# SSRF guard: true allows loopback / private webhook targets (local development only).
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# --- Alert deliveries (retries with exponential backoff) ---------------------------------
DELIVERY_MAX_ATTEMPTS=6
# First retry delay, doubled per attempt (30 s, 1 min, 2 min, …) up to DELIVERY_RETRY_MAX_MS.
DELIVERY_RETRY_BASE_MS=30000
DELIVERY_RETRY_MAX_MS=3600000
DELIVERY_POLL_INTERVAL_MS=1000
# Attempts in flight per instance: free slots are refilled at once, so a slow
# receiver holds one slot (at most its timeout), never the other deliveries.
DELIVERY_CONCURRENCY=20
# A claimed delivery whose instance crashed is retried by any instance after the
# lease; at least twice the longest of WEBHOOK_TIMEOUT_MS / TELEGRAM_TIMEOUT_MS.
DELIVERY_LEASE_MS=120000

# --- Realtime gateway (socket.io at /ws, spec §9) --------------------------------------
REALTIME_TILE_BATCH_INTERVAL_MS=1000
REALTIME_ALL_TILES_BATCH_INTERVAL_MS=5000
# Vessels whose latest position / safety state is kept in memory (LRU).
REALTIME_MAX_VESSELS=200000
REALTIME_MAX_VESSEL_SUBSCRIPTIONS=100
# Close the transport when the access token expires (clients reconnect with a fresh one).
REALTIME_REAUTH_ON_TOKEN_EXPIRY=true

# --- Housekeeping ----------------------------------------------------------------------
# Processed event ids (redelivery detection); at least the 90 days of the ALERTS stream.
IDEMPOTENCY_RETENTION_DAYS=90
# Finished deliveries and e-mail log rows. (The hourly housekeeping also queues
# lost alert e-mails again and prunes open-alert entries of dropped alerts.)
NOTIFICATION_LOG_RETENTION_DAYS=180

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
