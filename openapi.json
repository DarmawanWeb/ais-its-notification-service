  "info": {
    "title": "AIS Maritime Intelligence — AIS ITS Notification Service",
    "description": "Alert inbox, alert rules and deliveries (e-mail, Telegram, webhook), transactional e-mail and the realtime WebSocket gateway. Realtime: socket.io at path /ws on the same origin (handshake auth { token }, events of @darmawanweb/ais-its-contracts/realtime).",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "alerts",
      "description": "Alert inbox of safety and surveillance alerts"
    },
    {
      "name": "alert-rules",
      "description": "Alert rules and their delivery channels"
    },
    {
      "name": "notifications",
      "description": "Test notifications and the delivery log"
    },
    {
      "name": "methodology",
      "description": "Methods of the methodology catalog implemented here"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Access token (EdDSA JWT)"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key sk_<id>_<secret>"
      },
      "internalToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Token",
        "description": "Service-to-service token"
      }
    },
    "schemas": {
      "LocalizedTextDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Bahasa Indonesia"
          },
          "en": {
            "type": "string",
            "description": "English"
          }
        },
        "required": [
          "id",
          "en"
        ]
      },
      "MethodReferenceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "imo-mepc-352-78"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "format": "uri"
          }
        },
        "required": [
          "id",
          "title",
          "url"
        ]
      },
      "MethodSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cii.attained"
          },
          "catalogued": {
            "type": "boolean",
            "description": "Whether the catalog shipped with @darmawanweb/ais-its-contracts describes the method"
          },
          "domain": {
            "type": "string",
            "enum": [
              "ais",
              "emission",
              "seemp",
              "telemetry",
              "geo",
              "safety",
              "surveillance"
            ],
            "nullable": true
          },
          "name": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/LocalizedTextDto"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "implemented",
              "planned",
              "deprecated"
            ],
            "nullable": true
          },
          "needsCitation": {
            "type": "boolean",
            "description": "Values come from the thesis without a verified external source"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MethodReferenceDto"
            }
          }
        },
        "required": [
          "id",
          "catalogued",
          "domain",
          "name",
          "status",
          "needsCitation",
          "references"
        ]
      },
      "MethodologyDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "example": "notification"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MethodSummaryDto"
            }
          }
        },
        "required": [
          "service",
          "methods"
        ]
      },
      "RuleChannelDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "email",
              "telegram",
              "webhook"
            ]
          },
          "target": {
            "type": "string",
            "description": "email: an address; telegram: a chat id or @channel; webhook: an http(s) URL receiving signed JSON POSTs",
            "maxLength": 2048,
            "example": "ops@example.com"
          }
        },
        "required": [
          "type",
          "target"
        ]
      },
      "CreateAlertRuleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Pipeline danger to the operations room"
          },
          "scope": {
            "type": "string",
            "enum": [
              "org",
              "all"
            ],
            "description": "org: vessels of the organization; all: every vessel (only rules of an authority organization, written by its authority members). Default all for those, else org."
          },
          "types": {
            "example": [
              "ews",
              "collision"
            ],
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "enum": [
                "safety",
                "surveillance"
              ]
            }
          },
          "minSeverity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "default": "info"
          },
          "mmsi": {
            "example": [
              525005223
            ],
            "default": [],
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "zoneIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "channels": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleChannelDto"
            }
          },
          "locale": {
            "type": "string",
            "enum": [
              "id",
              "en"
            ],
            "default": "id"
          },
          "quietMinutes": {
            "type": "number",
            "minimum": 0,
            "maximum": 10080,
            "default": 0,
            "description": "Quiet period, minutes: an alert is not notified again by this rule within it unless its severity rises"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "orgId": {
            "type": "string",
            "format": "uuid",
            "description": "Owning organization (super_admin only; default the active organization)"
          }
        },
        "required": [
          "name",
          "channels"
        ]
      },
      "RuleChannelViewDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "email",
              "telegram",
              "webhook"
            ]
          },
          "target": {
            "type": "string",
            "description": "E-mail address, Telegram chat id / @channel, or webhook URL",
            "example": "ops@example.com"
          }
        },
        "required": [
          "type",
          "target"
        ]
      },
      "AlertRuleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orgId": {
            "type": "string",
            "format": "uuid",
            "description": "Owning organization"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Pipeline danger to the operations room"
          },
          "scope": {
            "type": "string",
            "enum": [
              "org",
              "all"
            ],
