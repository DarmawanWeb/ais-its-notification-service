              "default": 100,
              "type": "integer"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "Start (ISO-8601); default: endpoint specific",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "End (ISO-8601); default: now",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "acknowledged",
                "resolved"
              ]
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "schema": {
              "example": "ews",
              "type": "string"
            }
          },
          {
            "name": "domain",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "safety",
                "surveillance"
              ]
            }
          },
          {
            "name": "severity",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            }
          },
          {
            "name": "mmsi",
            "required": false,
            "in": "query",
            "description": "Vessel or related vessel",
            "schema": {
              "example": 525005223,
              "type": "number"
            }
          }
